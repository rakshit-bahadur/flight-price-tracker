{
  "name": "flight-price-tracker",
  "description": "Every 3 hours: ingest flight schedules and fares, build silver and gold tables, send price-drop alerts.",
  "git_source": {
    "git_url": "https://github.com/rakshit-bahadur/flight-price-tracker",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 0/3 * * ?",
    "timezone_id": "Asia/Kolkata",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "tasks": [
    {
      "task_key": "ingest_flight_schedules",
      "notebook_task": {
        "notebook_path": "notebooks/ingest_flight_schedules",
        "source": "GIT",
        "base_parameters": {"windows": "2"}
      },
      "max_retries": 1,
      "min_retry_interval_millis": 300000
    },
    {
      "task_key": "ingest_fare_quotes",
      "depends_on": [{"task_key": "ingest_flight_schedules"}],
      "notebook_task": {
        "notebook_path": "notebooks/ingest_fare_quotes",
        "source": "GIT",
        "base_parameters": {"fare_provider": "simulated"}
      }
    },
    {
      "task_key": "transform_flight_data",
      "depends_on": [{"task_key": "ingest_fare_quotes"}],
      "notebook_task": {
        "notebook_path": "notebooks/transform_flight_data",
        "source": "GIT"
      }
    },
    {
      "task_key": "aggregate_flight_prices",
      "depends_on": [{"task_key": "transform_flight_data"}],
      "notebook_task": {
        "notebook_path": "notebooks/aggregate_flight_prices",
        "source": "GIT"
      }
    },
    {
      "task_key": "send_price_alerts",
      "depends_on": [{"task_key": "aggregate_flight_prices"}],
      "notebook_task": {
        "notebook_path": "notebooks/send_price_alerts",
        "source": "GIT"
      }
    }
  ]
}
